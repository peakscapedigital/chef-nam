# Supply-chain cooldown. Do not resolve npm versions younger than 7 days.
# Defeats zero-day worms (Shai-Hulud and similar) that live for hours before takedown.
# Safe: does NOT affect "npm ci" or lockfile installs, only new resolves (install/update).
# Canon: Workspace/systems-v2/supply-chain-hygiene.md
min-release-age=7
